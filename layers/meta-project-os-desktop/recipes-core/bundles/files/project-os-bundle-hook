#!/bin/sh
# project-os — hook of the update bundle (steps 4c.3 and 4c.4, D-047, D-048).
#
# RAUC runs it with "slot-post-install" right after writing the new system into the
# inactive slot and before marking that slot bootable. It copies the boot files of the
# new system (UKI, kernel, initramfs, command lines with the dm-verity root hash),
# carried by this bundle, to the EFI partition as EFI/project-os/<bootname>, where GRUB
# finds them. If it fails, RAUC stops the installation and the slot stays not bootable.
set -eu

[ "${1:-}" = "slot-post-install" ] || exit 0
[ "${RAUC_SLOT_CLASS:-}" = "rootfs" ] || exit 0

# Only the two slots GRUB knows; never the booted one, which RAUC does not install to
bootname=${RAUC_SLOT_BOOTNAME:-}
case "$bootname" in
    A | B) ;;
    *)
        echo "project-os: unexpected slot boot name '$bootname'" >&2
        exit 1
        ;;
esac

# The boot directory sits next to this hook, in the mounted bundle
bundle_dir=$(dirname "$0")
set -- "$bundle_dir"/*.slot-boot
if [ "$#" -ne 1 ] || [ ! -f "$1/project-os.efi" ] || [ ! -f "$1/boot.env" ]; then
    echo "project-os: the bundle must hold exactly one *.slot-boot directory" >&2
    exit 1
fi

# The old files of this slot go first: RAUC has already marked it not bootable, and
# the EFI partition (512 MiB) then never holds more than two sets of boot files besides
# the new one. The new files are written under another name and renamed at the end, so
# GRUB never finds a half-written directory.
slots=/efi/EFI/project-os
mkdir -p "$slots"
rm -rf "${slots:?}/${bootname:?}" "${slots:?}/${bootname:?}.new"
cp -r "$1" "$slots/$bootname.new"
sync
mv "$slots/$bootname.new" "$slots/$bootname"
sync
echo "project-os: boot files of slot $bootname written to $slots/$bootname"
