# short-description: project-os desktop — A/B partitions (D-026)
# .wks.in file: bitbake substitutes the variables (${EFI_PROVIDER}) before passing it to wic.
# long-description: GPT bootable from UEFI and (from step 4e) from BIOS.
#   1 bios_grub   1 MiB   room for GRUB when the PC boots from BIOS (R-26)
#   2 esp         512 MiB EFI partition: GRUB, menu, theme, slot state
#   3 root_a      4 GiB   system, copy A (read-only)
#   4 root_b      4 GiB   system, copy B: empty, written by the first update
#   5 data        rest    created on first boot by systemd-repart, encrypted (LUKS2)
# The system slot will become erofs + dm-verity in step 4c.
# The ESP has no mount point here: wic would write the fstab line only on the
# first-installation disk, not in the slots written by updates. efi.mount
# (project-os-storage) mounts it, by GPT label.

part --source empty --size 1M --part-name bios_grub --part-type 21686148-6449-6E6F-744E-656564454649 --align 1024
part --source bootimg_efi --sourceparams="loader=${EFI_PROVIDER}" --fstype=vfat --label ESP --part-name esp --part-type C12A7328-F81F-11D2-BA4B-00A0C93EC93B --fsoptions="umask=0077" --active --align 1024 --fixed-size 512M
part / --source rootfs --fstype=ext4 --label root --part-name root_a --part-type 4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709 --align 1024 --fixed-size 4096M
part --source empty --part-name root_b --part-type 4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709 --align 1024 --fixed-size 4096M

bootloader --ptable gpt --timeout=5 --configfile="project-os-grub.cfg"
