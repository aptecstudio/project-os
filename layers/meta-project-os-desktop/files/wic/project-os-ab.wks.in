# short-description: project-os desktop — partizioni A/B (D-026)
# File .wks.in: bitbake sostituisce le variabili (${EFI_PROVIDER}) prima di passarlo a wic.
# long-description: GPT avviabile da UEFI e (dal passo 4e) da BIOS.
#   1 bios_grub   1 MiB   spazio per GRUB quando il PC avvia da BIOS (R-26)
#   2 esp         512 MiB partizione EFI: GRUB, menu, tema, stato degli slot
#   3 root_a      4 GiB   sistema, copia A (sola lettura)
#   4 root_b      4 GiB   sistema, copia B: vuota, la scrive il primo aggiornamento
#   5 data        resto   creata al primo avvio da systemd-repart, cifrata (LUKS2)
# Lo slot di sistema diventerà erofs + dm-verity al passo 4c.
# L'ESP non ha punto di montaggio qui: wic scriverebbe la riga di fstab solo nel disco di
# prima installazione, non negli slot degli aggiornamenti. La monta efi.mount
# (project-os-storage), per etichetta GPT.

part --source empty --size 1M --part-name bios_grub --part-type 21686148-6449-6E6F-744E-656564454649 --align 1024
part --source bootimg_efi --sourceparams="loader=${EFI_PROVIDER}" --fstype=vfat --label ESP --part-name esp --part-type C12A7328-F81F-11D2-BA4B-00A0C93EC93B --fsoptions="umask=0077" --active --align 1024 --fixed-size 512M
part / --source rootfs --fstype=ext4 --label root --part-name root_a --part-type 4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709 --align 1024 --fixed-size 4096M
part --source empty --part-name root_b --part-type 4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709 --align 1024 --fixed-size 4096M

bootloader --ptable gpt --timeout=5 --configfile="project-os-grub.cfg"
